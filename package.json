{
  "name": "shaft",
  "version": "1.12.0",
  "private": true,
  "description": "A GitHub Action that reviews pull requests with Claude through the Claude Agent SDK.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun src/meta.ts && bun build src/main.ts --target node --outfile dist/index.js && bun build src/post.ts --target node --outfile dist/post.js",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version && bun run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.325"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.6.6",
    "opencode-ai": "1.19.6",
    "oxlint": "1.90.0",
    "oxlint-config-universe": "0.2.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
